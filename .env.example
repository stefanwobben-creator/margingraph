# Public base URL. Used for canonical tags, the sitemap, RSS, robots.txt,
# Open Graph and every absolute URL in structured data.
#
# REQUIRED in production. Without it the build falls back to
# VERCEL_PROJECT_PRODUCTION_URL, and without that to localhost — which would
# publish a sitemap and canonicals pointing at localhost.
NEXT_PUBLIC_SITE_URL=https://margingraph.com

# Google Analytics 4 measurement ID, in the form G-XXXXXXXXXX.
#
# OPTIONAL. Leave it unset and no analytics code, script or connection to
# Google exists at all — including in the Content-Security-Policy.
#
# Tracking additionally requires a real production deploy: previews and local
# development send nothing even when this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
